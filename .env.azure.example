# Copy to .env.azure (gitignored) for scripts/azure-deploy.sh. No secrets here, only the target.
AZ_SUBSCRIPTION=<subscription-id>
AZ_RESOURCE_GROUP=Hochstapler
# optional, default hochstapler
# AZ_APP_NAME=hochstapler
# optional: custom domain with a free managed certificate (needs DNS records first, see README "Custom domain")
# AZ_CUSTOM_DOMAIN=game.example.com
