{
  "name": "hochstapler",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w @poly/server\" \"npm run dev -w @poly/client\"",
    "build": "npm run build -w @poly/client",
    "start": "npm run start -w @poly/server",
    "test": "npm test -w @poly/engine -w @poly/server -w @poly/client",
    "typecheck": "tsc -p packages/engine && tsc -p e2e && tsc -p packages/server && tsc -p packages/client && tsc -p scripts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/*/{src,test}/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\" \"e2e/**/*.ts\" \"apphost/*.mts\"",
    "format:check": "prettier --check \"packages/*/{src,test}/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\" \"e2e/**/*.ts\" \"apphost/*.mts\"",
    "prepare": "simple-git-hooks",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build:verify && npm test",
    "security": "node scripts/security.mjs",
    "test:e2e": "bddgen && playwright test",
    "test:responsive": "playwright test --project=se-320 --project=phone-390 --project=phone-landscape --project=tablet-portrait --project=tablet-landscape --project=desktop-1440",
    "test:responsive:update": "npm run test:responsive -- --update-snapshots",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "lan": "npm run build && npm start",
    "aspire": "npm ci --prefix apphost --ignore-scripts --no-audit --no-fund && aspire run --apphost apphost",
    "build:verify": "npm run build:verify -w @poly/client",
    "assets:tokens": "node scripts/tokens/render-thumbnails.mjs",
    "deploy:azure": "bash scripts/azure-deploy.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "lockfile-lint": "^5.1.0",
    "meshoptimizer": "^1.3.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/pre-commit.mjs"
  }
}
